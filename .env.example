# Server Configuration
PORT=3000

# Optional Bearer Token Authentication for POST /mcp
# When set, callers must provide "Authorization: Bearer <API_TOKEN>"
API_TOKEN=your-secret-api-token-here

# Optional GitHub Personal Access Token for higher rate limits on summarize_repo
GITHUB_TOKEN=your-github-personal-access-token-here

# Optional File-backed Persistence (leave unset for in-memory only)
# Note: By default, tasks are stored in-memory (single-user design)
TASKS_FILE=tasks.json

# CORS Configuration (defaults to *)
CORS_ORIGIN=*

# Rate Limiting (requests per minute per IP, defaults to 60)
RATE_LIMIT_PER_MIN=60

# Task Store implementation: "memory" (default) or "dynamodb"
TASK_STORE=memory
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=alexa-taskflow-tasks

# Optional: enables open-ended AI answers in the ALEXA demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
